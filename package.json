{
  "name": "assignment",
  "version": "1.0.0",
  "description": "Express.js app with TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "worker": "ts-node -r tsconfig-paths/register src/workers/withdrawalWorker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^25.5.2",
    "@types/winston": "^2.4.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "bullmq": "^5.73.0",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "mongoose": "^9.3.3",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
}
